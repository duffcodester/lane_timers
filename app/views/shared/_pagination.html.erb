<% if total_pages > 1 %>
  <nav class="pagination">
    <%# Previous %>
    <% if current_page > 1 %>
      <%= link_to "← Prev", url_for(params.permit!.merge(page: current_page - 1)), class: "page-link" %>
    <% else %>
      <span class="page-link page-link-disabled">← Prev</span>
    <% end %>

    <%# Page numbers — show up to 7 links with ellipsis %>
    <% page_window = 2 %>
    <% pages = (1..total_pages).select { |p|
         p == 1 || p == total_pages ||
         (p - current_page).abs <= page_window
       } %>

    <% prev_p = nil %>
    <% pages.each do |p| %>
      <% if prev_p && p - prev_p > 1 %>
        <span class="page-ellipsis">…</span>
      <% end %>
      <% if p == current_page %>
        <span class="page-link page-link-current"><%= p %></span>
      <% else %>
        <%= link_to p, url_for(params.permit!.merge(page: p)), class: "page-link" %>
      <% end %>
      <% prev_p = p %>
    <% end %>

    <%# Next %>
    <% if current_page < total_pages %>
      <%= link_to "Next →", url_for(params.permit!.merge(page: current_page + 1)), class: "page-link" %>
    <% else %>
      <span class="page-link page-link-disabled">Next →</span>
    <% end %>
  </nav>
<% end %>
