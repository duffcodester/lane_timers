<%= form_with(model: club, class: "team-form") do |f| %>
  <% if club.errors.any? %>
    <div class="errors">
      <h3><%= pluralize(club.errors.count, "error") %> prevented this club from being saved:</h3>
      <ul>
        <% club.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= f.label :abbreviation %>
    <%= f.text_field :abbreviation, maxlength: 5, required: true %>
  </div>

  <div class="field">
    <%= f.label :coach, "Coach Name(s)" %>
    <%= f.text_field :coach, required: true %>
  </div>

  <div class="field">
    <%= f.label :address, "Club Address (For Financial Reward)" %>
    <%= f.text_field :address, required: true %>
  </div>

  <div class="field">
    <%= f.label :phone, "Mobile Phone (10-digit)" %>
    <%= f.phone_field :phone, required: true %>
  </div>

  <div class="field">
    <%= f.label :email %>
    <%= f.email_field :email, required: true %>
  </div>

  <div class="field">
    <%= f.label :color %>
    <%= f.color_field :color, value: club.color || "#3498db" %>
  </div>

  <div class="actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", clubs_path, class: "btn" %>
  </div>
<% end %>
