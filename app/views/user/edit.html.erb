<% content_for :title, "Account – Sage Timer" %>

<h1>Account — <%= current_user.username %></h1>

<div class="form-card">
  <%= form_with url: update_current_user_path, method: :patch do |f| %>
    <% if alert %>
      <div class="flash flash-alert"><%= alert %></div>
    <% end %>

    <div class="field">
      <%= label_tag :name, "Name" %>
      <%= text_field_tag :name, params[:name] || current_user.name, class: "form-control", autofocus: true %>
    </div>

    <div class="field">
      <%= label_tag :phone, "Phone" %>
      <%= phone_field_tag :phone, params[:phone] || current_user.phone, class: "form-control" %>
    </div>

    <div class="field">
      <%= label_tag :club_id, "Club & Workout Group" %>
      <%= select_tag :club_id, options_for_select(@clubs.map { |c| ["#{c.abbreviation} - #{c.name}", c.id] }, current_user.club_id), include_blank: "— None —", class: "form-control" %>
    </div>

    <div class="field">
      <%= label_tag :username, "Username" %>
      <%= text_field_tag :username, params[:username] || current_user.username, autocomplete: "username", class: "form-control" %>
      <span class="form-hint">Letters, numbers, and underscores only</span>
    </div>

    <div class="field">
      <%= label_tag :password, "New Password" %>
      <div class="password-wrapper">
        <%= password_field_tag :password, nil, autocomplete: "new-password", class: "form-control" %>
        <button type="button" class="password-toggle" onclick="togglePassword(this)" aria-label="Show password">
          <svg class="eye-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="eye-closed" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
        </button>
      </div>
      <span class="form-hint">Leave blank to keep current password. Minimum 8 characters.</span>
    </div>

    <div class="field">
      <%= label_tag :password_confirmation, "Confirm New Password" %>
      <div class="password-wrapper">
        <%= password_field_tag :password_confirmation, nil, autocomplete: "new-password", class: "form-control" %>
        <button type="button" class="password-toggle" onclick="togglePassword(this)" aria-label="Show password">
          <svg class="eye-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="eye-closed" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
        </button>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit "Save", class: "btn btn-primary" %>
      <%= link_to "Cancel", users_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
