<h1>Edit Booking</h1>

<%= form_with model: @booking, class: "club-form" do |f| %>
  <input type="hidden" name="source" value="list">

  <% if @booking.errors.any? %>
    <div class="errors">
      <h3><%= pluralize(@booking.errors.count, "error") %> prevented this booking from being saved:</h3>
      <ul>
        <% @booking.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :club_id, "Club" %>
    <%= f.select :club_id, @clubs.map { |c| [c.abbreviation.presence || c.name, c.id] },
        { prompt: "Select a club..." }, required: true %>
  </div>

  <div class="field">
    <%= f.label :lane %>
    <%= f.number_field :lane, min: 0, max: 11, required: true, onchange: "toggleSubLane()" %>
  </div>

  <div class="field" id="sub-lane-field" style="<%= 'display:none' if [0, 11].include?(@booking.lane) %>">
    <%= f.label :sub_lane, "Timer (A/B)" %>
    <%= f.select :sub_lane, [["A", "A"], ["B", "B"]], { prompt: "Select..." }, required: (1..10).include?(@booking.lane) %>
  </div>

  <div class="field">
    <%= f.label :date %>
    <%= f.date_field :date, required: true %>
  </div>

  <div class="field">
    <%= f.label :start_time, "Start Time" %>
    <%= f.time_field :start_time, required: true, step: 900 %>
  </div>

  <div class="field">
    <%= f.label :end_time, "End Time" %>
    <%= f.time_field :end_time, required: true, step: 900 %>
  </div>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :phone, "Mobile Phone (10-digit)" %>
    <%= f.telephone_field :phone %>
  </div>

  <div class="field">
    <%= f.label :notes %>
    <%= f.text_area :notes, rows: 3 %>
  </div>

  <div class="field field-checkbox">
    <%= f.check_box :community_service %>
    <%= f.label :community_service, "Community Service" %>
  </div>

  <div class="actions">
    <%= f.submit "Save", class: "btn btn-primary" %>
    <%= link_to "Cancel", list_bookings_path, class: "btn" %>
  </div>
<% end %>

<script>
  function toggleSubLane() {
    var lane = parseInt(document.getElementById("booking_lane").value);
    var field = document.getElementById("sub-lane-field");
    if (lane >= 1 && lane <= 10) {
      field.style.display = "";
      field.querySelector("select").required = true;
    } else {
      field.style.display = "none";
      field.querySelector("select").required = false;
      field.querySelector("select").value = "";
    }
  }
</script>
