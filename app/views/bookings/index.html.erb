<h1>Lane Schedule — <%= @date.strftime("%A, %B %d, %Y") %></h1>

<div class="date-picker">
  <%= form_tag root_path, method: :get, class: "date-form" do %>
    <%= label_tag :date, "Date:" %>
    <%= date_field_tag :date, @date, onchange: "this.form.submit()", min: @min_date, max: @max_date %>
  <% end %>

  <div class="date-nav">
    <% if @min_date && @date > @min_date %>
      <%= link_to "< Prev", root_path(date: @date - 1.day), class: "btn btn-small" %>
    <% else %>
      <span class="btn btn-small btn-disabled">&lt; Prev</span>
    <% end %>
    <% if @max_date && @date < @max_date %>
      <%= link_to "Next >", root_path(date: @date + 1.day), class: "btn btn-small" %>
    <% else %>
      <span class="btn btn-small btn-disabled">Next &gt;</span>
    <% end %>
  </div>

  <%= button_to "Clear All Bookings", clear_bookings_path, method: :delete,
      class: "btn btn-small btn-danger",
      params: { date: @date },
      data: { turbo_confirm: "Are you sure you want to delete ALL bookings for #{@date.strftime('%B %d, %Y')}?" } %>
</div>

<% if @sessions.blank? %>
  <p class="empty-state">No session configured for this date. <%= link_to "Manage sessions", meet_sessions_path %>.</p>
<% elsif @teams.empty? %>
  <p class="empty-state">No teams created yet. <%= link_to "Create teams", teams_path %> first.</p>
<% else %>
  <div class="grid-wrapper" data-controller="drag">
    <table class="schedule-grid">
      <thead>
        <tr>
          <th class="session-col">Session</th>
          <th class="time-col">Time</th>
          <% @lanes.each do |lane| %>
            <th class="lane-col">Lane <%= lane %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @time_slots.each do |hour, min| %>
          <tr class="<%= min == 0 ? 'hour-row' : '' %>">
            <% if @session_starts[[hour, min]] %>
              <td class="session-cell" rowspan="<%= @session_starts[[hour, min]][:slots] %>">
                <%= @session_starts[[hour, min]][:name] %>
              </td>
            <% elsif !@session_covered.include?([hour, min]) %>
              <td class="session-cell"></td>
            <% end %>
            <td class="time-cell"><%= format_time(hour, min) %></td>
            <% @lanes.each do |lane| %>
              <% booking = @grid[[lane, hour, min]] %>
              <% if booking %>
                <% if booking.start_time.hour == hour && booking.start_time.min == min %>
                  <td class="booked-cell" rowspan="<%= booking.duration_slots %>"
                      draggable="true"
                      data-booking-id="<%= booking.id %>"
                      data-booking-name="<%= booking.name %>"
                      data-booking-phone="<%= booking.phone %>"
                      data-booking-end-time="<%= booking.end_time.strftime('%H:%M') %>"
                      data-action="dragstart->drag#dragstart dragend->drag#dragend"
                      onclick="openEditForm(this)"
                      style="background-color: <%= booking.team.color %>20; border-left: 4px solid <%= booking.team.color %>">
                    <div class="booking-content">
                      <span class="team-name"><%= booking.team.abbreviation.presence || booking.team.name %></span>
                      <% if booking.name.present? %>
                        <span class="booking-name"><%= booking.name %></span>
                      <% end %>
                      <% if booking.phone.present? %>
                        <span class="booking-phone"><%= booking.formatted_phone %></span>
                      <% end %>
                      <%= button_to "×", booking_path(booking), method: :delete,
                          class: "btn-remove", data: { turbo_confirm: "Remove this booking?" } %>
                    </div>
                  </td>
                <% end
                  # Skip cells covered by rowspan — do nothing
                %>
              <% else %>
                <td class="empty-cell"
                    data-lane="<%= lane %>" data-hour="<%= hour %>" data-min="<%= min %>"
                    data-action="dragover->drag#dragover dragenter->drag#dragenter dragleave->drag#dragleave drop->drag#drop"
                    onclick="openBookingForm(this)">
                </td>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>

    <!-- Hidden form for drag-and-drop updates -->
    <form method="post" action="<%= bookings_path %>/0" style="display:none"
          data-drag-target="form">
      <input type="hidden" name="_method" value="patch">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" name="booking[id]" data-drag-target="bookingId">
      <input type="hidden" name="booking[lane]" data-drag-target="lane">
      <input type="hidden" name="booking[start_time]" data-drag-target="startTime">
    </form>
  </div>

  <!-- Booking modal -->
  <div id="booking-modal" class="modal" style="display:none">
    <div class="modal-content">
      <h3>Book Lane</h3>
      <%= form_with url: bookings_path, method: :post, id: "booking-form" do |f| %>
        <input type="hidden" name="booking[lane]" id="booking-lane">
        <input type="hidden" name="booking[date]" value="<%= @date %>">
        <input type="hidden" name="booking[start_time]" id="booking-start-time">
        <input type="hidden" name="booking[end_time]" id="booking-end-time">

        <p id="booking-info"></p>

        <div class="field">
          <%= f.label :team_id, "Team" %>
          <%= f.select :team_id, @teams.map { |t| [t.abbreviation.presence || t.name, t.id] },
              { prompt: "Select a team..." }, { name: "booking[team_id]", required: true } %>
        </div>

        <div class="field">
          <label for="booking-duration">Duration</label>
          <select id="booking-duration" onchange="updateEndTime()">
            <option value="15">15 min</option>
            <option value="30">30 min</option>
            <option value="45">45 min</option>
            <option value="60" selected>60 min</option>
            <option value="75">1 hr 15 min</option>
            <option value="90">1 hr 30 min</option>
            <option value="105">1 hr 45 min</option>
            <option value="120">2 hr</option>
          </select>
        </div>

        <div class="actions">
          <%= f.submit "Book", class: "btn btn-primary" %>
          <button type="button" class="btn" onclick="closeBookingForm()">Cancel</button>
        </div>
      <% end %>
    </div>
  </div>
  <!-- Edit booking modal -->
  <div id="edit-modal" class="modal" style="display:none">
    <div class="modal-content">
      <h3>Edit Booking</h3>
      <form method="post" id="edit-form" action="">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

        <div class="field">
          <label for="edit-end-time">End Time</label>
          <input type="time" name="booking[end_time]" id="edit-end-time" step="900">
        </div>

        <div class="field">
          <label for="edit-name">Name</label>
          <input type="text" name="booking[name]" id="edit-name">
        </div>

        <div class="field">
          <label for="edit-phone">Phone</label>
          <input type="tel" name="booking[phone]" id="edit-phone">
        </div>

        <div class="actions">
          <button type="submit" class="btn btn-primary">Save</button>
          <button type="button" class="btn" onclick="closeEditForm()">Cancel</button>
        </div>
      </form>
    </div>
  </div>
<% end %>

<script>
  var bookingStartHour, bookingStartMin;

  function openBookingForm(cell) {
    var lane = cell.dataset.lane;
    var hour = cell.dataset.hour;
    var min = cell.dataset.min;

    bookingStartHour = parseInt(hour);
    bookingStartMin = parseInt(min);

    document.getElementById("booking-lane").value = lane;
    document.getElementById("booking-start-time").value =
      hour.padStart(2, '0') + ":" + min.padStart(2, '0');
    document.getElementById("booking-duration").value = "60";
    updateEndTime();
    document.getElementById("booking-info").textContent =
      "Lane " + lane + " at " + formatTime(parseInt(hour), parseInt(min));
    document.getElementById("booking-modal").style.display = "flex";
  }

  function updateEndTime() {
    var duration = parseInt(document.getElementById("booking-duration").value);
    var totalMin = bookingStartHour * 60 + bookingStartMin + duration;
    var endHour = Math.floor(totalMin / 60);
    var endMin = totalMin % 60;
    document.getElementById("booking-end-time").value =
      endHour.toString().padStart(2, '0') + ":" + endMin.toString().padStart(2, '0');
  }

  function closeBookingForm() {
    document.getElementById("booking-modal").style.display = "none";
  }

  function formatTime(hour, min) {
    var ampm = hour >= 12 ? "PM" : "AM";
    var h = hour > 12 ? hour - 12 : (hour === 0 ? 12 : hour);
    var m = min.toString().padStart(2, '0');
    return h + ":" + m + " " + ampm;
  }

  // Edit modal
  var isDragging = false;

  document.addEventListener("dragstart", function() { isDragging = true; });
  document.addEventListener("dragend", function() { setTimeout(function() { isDragging = false; }, 0); });

  function openEditForm(cell) {
    if (isDragging) return;
    var bookingId = cell.dataset.bookingId;
    var name = cell.dataset.bookingName || "";
    var phone = cell.dataset.bookingPhone || "";
    var endTime = cell.dataset.bookingEndTime || "";

    document.getElementById("edit-form").action = "/bookings/" + bookingId;
    document.getElementById("edit-name").value = name;
    document.getElementById("edit-phone").value = phone;
    document.getElementById("edit-end-time").value = endTime;
    document.getElementById("edit-modal").style.display = "flex";
  }

  function closeEditForm() {
    document.getElementById("edit-modal").style.display = "none";
  }

  // Close modals on escape
  document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") {
      closeBookingForm();
      closeEditForm();
    }
  });

  // Close modals on background click
  document.getElementById("booking-modal")?.addEventListener("click", function(e) {
    if (e.target === this) closeBookingForm();
  });
  document.getElementById("edit-modal")?.addEventListener("click", function(e) {
    if (e.target === this) closeEditForm();
  });

  // Preserve scroll position after form submissions
  function preserveScroll() {
    var scrollY = window.scrollY;
    document.addEventListener("turbo:load", function() {
      window.scrollTo(0, scrollY);
    }, { once: true });
  }

  document.getElementById("booking-form")?.addEventListener("turbo:submit-start", preserveScroll);
  document.getElementById("edit-form")?.addEventListener("turbo:submit-start", preserveScroll);

  // Also preserve scroll for delete buttons
  document.querySelectorAll(".btn-remove").forEach(function(btn) {
    btn.closest("form")?.addEventListener("turbo:submit-start", preserveScroll);
  });
</script>
