<h1>Lane Schedule — <%= @date.strftime("%A, %B %d, %Y") %></h1>

<div class="date-picker">
  <%= form_tag root_path, method: :get, class: "date-form" do %>
    <%= label_tag :date, "Date:" %>
    <%= date_field_tag :date, @date, onchange: "this.form.submit()", min: @min_date, max: @max_date %>
  <% end %>

  <div class="date-nav">
    <% if @min_date && @date > @min_date %>
      <%= link_to "< Prev", root_path(date: @date - 1.day), class: "btn btn-small" %>
    <% else %>
      <span class="btn btn-small btn-disabled">&lt; Prev</span>
    <% end %>
    <% if @max_date && @date < @max_date %>
      <%= link_to "Next >", root_path(date: @date + 1.day), class: "btn btn-small" %>
    <% else %>
      <span class="btn btn-small btn-disabled">Next &gt;</span>
    <% end %>
  </div>

  <% if @teams&.any? %>
    <div class="columns-dropdown" id="team-filter-dropdown">
      <button type="button" class="btn btn-small" onclick="toggleTeamFilterMenu()">Filter Teams</button>
      <div id="team-filter-menu" class="columns-menu" style="display:none">
        <div class="team-filter-actions">
          <button type="button" class="btn btn-small" onclick="selectAllTeams()">All</button>
          <button type="button" class="btn btn-small" onclick="selectNoneTeams()">None</button>
        </div>
        <% @teams.each do |team| %>
          <label>
            <input type="checkbox" data-team-id="<%= team.id %>"
                   onchange="applyTeamFilter()"
                   checked>
            <span class="color-swatch" style="background-color: <%= team.color %>; display:inline-block; vertical-align:middle"></span>
            <%= team.abbreviation.presence || team.name %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

</div>

<% if @sessions.blank? %>
  <p class="empty-state">No session configured for this date. <%= link_to "Manage sessions", meet_sessions_path %>.</p>
<% elsif @teams.empty? %>
  <p class="empty-state">No teams created yet. <%= link_to "Create teams", teams_path %> first.</p>
<% else %>
  <div class="grid-wrapper" data-controller="drag resize" data-schedule-date="<%= @date.iso8601 %>">
    <table class="schedule-grid">
      <thead>
        <tr>
          <th class="session-col" rowspan="2">Session</th>
          <th class="time-col" rowspan="2">Time</th>
          <% @lanes.each do |lane| %>
            <% if [0, 11].include?(lane) %>
              <th class="lane-col" rowspan="2">Lane <%= lane %></th>
            <% else %>
              <th class="lane-col" colspan="2">Lane <%= lane %></th>
            <% end %>
          <% end %>
        </tr>
        <tr>
          <% @lanes.each do |lane| %>
            <% unless [0, 11].include?(lane) %>
              <th class="sub-lane-col">A</th>
              <th class="sub-lane-col">B</th>
            <% end %>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @time_slots.each do |hour, min| %>
          <tr class="<%= min == 0 ? 'hour-row' : '' %>" data-hour="<%= hour %>" data-min="<%= min %>">
            <% if @session_starts[[hour, min]] %>
              <% ss = @session_starts[[hour, min]] %>
              <td class="session-cell<%= ' session-closed' if ss[:closed] %><%= ' session-break' if ss[:break_period] %>" rowspan="<%= ss[:slots] %>">
                <%= ss[:name] %>
                <% if ss[:closed] %>
                  <br><span class="closed-label">Closed</span>
                <% elsif ss[:break_period] %>
                  <br><span class="break-label">Break</span>
                <% end %>
              </td>
            <% elsif !@session_covered.include?([hour, min]) %>
              <td class="session-cell"></td>
            <% end %>
            <td class="time-cell"><%= format_time(hour, min) %></td>
            <% @columns.each do |col| %>
              <% booking = @grid[[col[:lane], col[:sub_lane], hour, min]] %>
              <% if booking %>
                <% if booking.start_time.hour == hour && booking.start_time.min == min %>
                  <td class="booked-cell" rowspan="<%= booking.duration_slots %>"
                      draggable="true"
                      data-team-id="<%= booking.team.id %>"
                      data-booking-id="<%= booking.id %>"
                      data-booking-name="<%= booking.name %>"
                      data-booking-phone="<%= booking.phone %>"
                      data-booking-start-time="<%= booking.start_time.strftime('%H:%M') %>"
                      data-booking-end-time="<%= booking.end_time.strftime('%H:%M') %>"
                      data-booking-notes="<%= booking.notes %>"
                      data-booking-community-service="<%= booking.community_service %>"
                      data-action="dragstart->drag#dragstart dragend->drag#dragend"
                      onclick="openEditForm(event, this)"
                      style="background-color: <%= booking.team.color %>20; border-left: 4px solid <%= booking.team.color %>">
                    <div class="resize-handle resize-handle-top" draggable="false"
                         data-action="mousedown->resize#startTop"></div>
                    <div class="booking-content">
                      <span class="team-name"><%= booking.team.abbreviation.presence || booking.team.name %></span>
                      <% if booking.name.present? %>
                        <span class="booking-name"><%= booking.name %></span>
                      <% end %>
                      <%= button_to "×", booking_path(booking), method: :delete,
                          class: "btn-remove", data: { turbo_confirm: "Remove this booking?" } %>
                    </div>
                    <div class="resize-handle resize-handle-bottom" draggable="false"
                         data-action="mousedown->resize#startBottom"></div>
                  </td>
                <% end
                  # Skip cells covered by rowspan — do nothing
                %>
              <% else %>
                <% if @closed_slots.include?([hour, min]) %>
                  <td class="disabled-cell"></td>
                <% else %>
                  <td class="empty-cell"
                      data-lane="<%= col[:lane] %>" data-sub-lane="<%= col[:sub_lane] %>" data-hour="<%= hour %>" data-min="<%= min %>"
                      data-action="dragover->drag#dragover dragenter->drag#dragenter dragleave->drag#dragleave drop->drag#drop"
                      onclick="openBookingForm(this)">
                  </td>
                <% end %>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>

    <!-- Hidden form for drag-and-drop updates -->
    <form method="post" action="<%= bookings_path %>/0" style="display:none"
          data-drag-target="form">
      <input type="hidden" name="_method" value="patch">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" name="booking[id]" data-drag-target="bookingId">
      <input type="hidden" name="booking[lane]" data-drag-target="lane">
      <input type="hidden" name="booking[sub_lane]" data-drag-target="subLane">
      <input type="hidden" name="booking[start_time]" data-drag-target="startTime">
    </form>

    <!-- Hidden form for resize updates -->
    <form method="post" action="<%= bookings_path %>/0" style="display:none"
          data-resize-target="form">
      <input type="hidden" name="_method" value="patch">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" name="booking[id]" data-resize-target="bookingId">
      <input type="hidden" name="booking[start_time]" data-resize-target="startTime">
      <input type="hidden" name="booking[end_time]" data-resize-target="endTime">
    </form>
  </div>

  <!-- Booking modal -->
  <div id="booking-modal" class="modal" style="display:none">
    <div class="modal-content">
      <h3>Claim Lane</h3>
      <%= form_with url: bookings_path, method: :post, id: "booking-form" do |f| %>
        <input type="hidden" name="booking[lane]" id="booking-lane">
        <input type="hidden" name="booking[sub_lane]" id="booking-sub-lane">
        <input type="hidden" name="booking[date]" value="<%= @date %>">
        <input type="hidden" name="booking[start_time]" id="booking-start-time">
        <input type="hidden" name="booking[end_time]" id="booking-end-time">

        <p id="booking-info"></p>

        <div class="field">
          <%= f.label :team_id, "Team" %>
          <%= f.select :team_id, @teams.map { |t| [t.abbreviation.presence || t.name, t.id] },
              { prompt: "Select a team..." }, { name: "booking[team_id]", required: true } %>
        </div>

        <div class="field">
          <label for="booking-duration">Duration</label>
          <select id="booking-duration" onchange="updateEndTime()">
            <option value="15">15 min</option>
            <option value="30">30 min</option>
            <option value="45">45 min</option>
            <option value="60" selected>60 min</option>
            <option value="75">1 hr 15 min</option>
            <option value="90">1 hr 30 min</option>
            <option value="105">1 hr 45 min</option>
            <option value="120">2 hr</option>
          </select>
        </div>

        <div class="field">
          <label for="booking-name">Name</label>
          <input type="text" name="booking[name]" id="booking-name">
        </div>

        <div class="field">
          <label for="booking-phone">Mobile Phone (10-digit)</label>
          <input type="tel" name="booking[phone]" id="booking-phone">
        </div>

        <div class="field">
          <label for="booking-notes">Notes</label>
          <textarea name="booking[notes]" id="booking-notes" rows="2"></textarea>
        </div>

        <div class="field field-checkbox">
          <input type="hidden" name="booking[community_service]" value="0">
          <label><input type="checkbox" name="booking[community_service]" id="booking-community-service" value="1"> Community Service</label>
        </div>

        <div class="actions">
          <%= f.submit "Claim", class: "btn btn-primary" %>
          <button type="button" class="btn" onclick="closeBookingForm()">Cancel</button>
        </div>
      <% end %>
    </div>
  </div>
  <!-- Edit booking modal -->
  <div id="edit-modal" class="modal" style="display:none">
    <div class="modal-content">
      <h3>Edit Lane</h3>
      <form method="post" id="edit-form" action="">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

        <div class="field">
          <label for="edit-start-time">Start Time</label>
          <input type="time" name="booking[start_time]" id="edit-start-time" step="900">
        </div>

        <div class="field">
          <label for="edit-end-time">End Time</label>
          <input type="time" name="booking[end_time]" id="edit-end-time" step="900">
        </div>

        <div class="field">
          <label for="edit-name">Name</label>
          <input type="text" name="booking[name]" id="edit-name">
        </div>

        <div class="field">
          <label for="edit-phone">Mobile Phone (10-digit)</label>
          <input type="tel" name="booking[phone]" id="edit-phone">
        </div>

        <div class="field">
          <label for="edit-notes">Notes</label>
          <textarea name="booking[notes]" id="edit-notes" rows="2"></textarea>
        </div>

        <div class="field field-checkbox">
          <input type="hidden" name="booking[community_service]" value="0">
          <label><input type="checkbox" name="booking[community_service]" id="edit-community-service" value="1"> Community Service</label>
        </div>

        <div class="actions">
          <button type="submit" class="btn btn-primary">Save</button>
          <button type="button" class="btn" onclick="closeEditForm()">Cancel</button>
        </div>
      </form>
    </div>
  </div>
<% end %>

<script>
  var bookingStartHour, bookingStartMin;

  function openBookingForm(cell) {
    var lane = cell.dataset.lane;
    var subLane = cell.dataset.subLane || "";
    var hour = cell.dataset.hour;
    var min = cell.dataset.min;

    bookingStartHour = parseInt(hour);
    bookingStartMin = parseInt(min);

    document.getElementById("booking-lane").value = lane;
    document.getElementById("booking-sub-lane").value = subLane;
    document.getElementById("booking-start-time").value =
      hour.padStart(2, '0') + ":" + min.padStart(2, '0');
    document.getElementById("booking-duration").value = "60";
    document.getElementById("booking-name").value = "";
    document.getElementById("booking-phone").value = "";
    document.getElementById("booking-notes").value = "";
    document.getElementById("booking-community-service").checked = false;
    updateEndTime();
    var laneLabel = subLane ? "Lane " + lane + subLane : "Lane " + lane;
    document.getElementById("booking-info").textContent =
      laneLabel + " at " + formatTime(parseInt(hour), parseInt(min));
    document.getElementById("booking-modal").style.display = "flex";
  }

  function updateEndTime() {
    var duration = parseInt(document.getElementById("booking-duration").value);
    var totalMin = bookingStartHour * 60 + bookingStartMin + duration;
    var endHour = Math.floor(totalMin / 60);
    var endMin = totalMin % 60;
    document.getElementById("booking-end-time").value =
      endHour.toString().padStart(2, '0') + ":" + endMin.toString().padStart(2, '0');
  }

  function closeBookingForm() {
    document.getElementById("booking-modal").style.display = "none";
  }

  function formatTime(hour, min) {
    var ampm = hour >= 12 ? "PM" : "AM";
    var h = hour > 12 ? hour - 12 : (hour === 0 ? 12 : hour);
    var m = min.toString().padStart(2, '0');
    return h + ":" + m + " " + ampm;
  }

  // Edit modal
  var isDragging = false;

  document.addEventListener("dragstart", function() { isDragging = true; });
  document.addEventListener("dragend", function() { setTimeout(function() { isDragging = false; }, 0); });

  function openEditForm(event, cell) {
    if (isDragging) return;
    if (event.target.closest(".resize-handle")) return;
    var bookingId = cell.dataset.bookingId;
    var name = cell.dataset.bookingName || "";
    var phone = cell.dataset.bookingPhone || "";
    var startTime = cell.dataset.bookingStartTime || "";
    var endTime = cell.dataset.bookingEndTime || "";
    var notes = cell.dataset.bookingNotes || "";
    var communityService = cell.dataset.bookingCommunityService === "true";

    document.getElementById("edit-form").action = "/bookings/" + bookingId;
    document.getElementById("edit-start-time").value = startTime;
    document.getElementById("edit-name").value = name;
    document.getElementById("edit-phone").value = phone;
    document.getElementById("edit-end-time").value = endTime;
    document.getElementById("edit-notes").value = notes;
    document.getElementById("edit-community-service").checked = communityService;
    document.getElementById("edit-modal").style.display = "flex";
  }

  function closeEditForm() {
    document.getElementById("edit-modal").style.display = "none";
  }

  // Close modals on escape
  document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") {
      closeBookingForm();
      closeEditForm();
    }
  });

  // Close modals on background click
  document.getElementById("booking-modal")?.addEventListener("click", function(e) {
    if (e.target === this) closeBookingForm();
  });
  document.getElementById("edit-modal")?.addEventListener("click", function(e) {
    if (e.target === this) closeEditForm();
  });

  // Preserve scroll position after form submissions
  function preserveScroll() {
    var scrollY = window.scrollY;
    document.addEventListener("turbo:load", function() {
      window.scrollTo(0, scrollY);
    }, { once: true });
  }

  document.getElementById("booking-form")?.addEventListener("turbo:submit-start", preserveScroll);
  document.getElementById("edit-form")?.addEventListener("turbo:submit-start", preserveScroll);

  // Also preserve scroll for delete buttons
  document.querySelectorAll(".btn-remove").forEach(function(btn) {
    btn.closest("form")?.addEventListener("turbo:submit-start", preserveScroll);
  });

  // ── Team filter ──────────────────────────────────────────────────────────
  var FILTER_KEY = "schedule_team_filter";

  function toggleTeamFilterMenu() {
    var menu = document.getElementById("team-filter-menu");
    menu.style.display = menu.style.display === "none" ? "block" : "none";
  }

  function applyTeamFilter() {
    var hidden = getHiddenTeams();
    saveHiddenTeams(hidden);
    document.querySelectorAll(".booked-cell[data-team-id]").forEach(function(cell) {
      if (hidden.includes(cell.dataset.teamId)) {
        cell.classList.add("team-hidden");
      } else {
        cell.classList.remove("team-hidden");
      }
    });
  }

  function selectAllTeams() {
    document.querySelectorAll("#team-filter-menu input[type='checkbox']").forEach(function(cb) {
      cb.checked = true;
    });
    applyTeamFilter();
  }

  function selectNoneTeams() {
    document.querySelectorAll("#team-filter-menu input[type='checkbox']").forEach(function(cb) {
      cb.checked = false;
    });
    applyTeamFilter();
  }

  function getHiddenTeams() {
    var hidden = [];
    document.querySelectorAll("#team-filter-menu input[type='checkbox']").forEach(function(cb) {
      if (!cb.checked) hidden.push(cb.dataset.teamId);
    });
    return hidden;
  }

  function saveHiddenTeams(hidden) {
    localStorage.setItem(FILTER_KEY, JSON.stringify(hidden));
  }

  function loadTeamFilter() {
    var saved = localStorage.getItem(FILTER_KEY);
    if (!saved) return;
    var hidden;
    try { hidden = JSON.parse(saved); } catch(e) { return; }
    if (!Array.isArray(hidden) || hidden.length === 0) return;
    document.querySelectorAll("#team-filter-menu input[type='checkbox']").forEach(function(cb) {
      if (hidden.includes(cb.dataset.teamId)) cb.checked = false;
    });
    applyTeamFilter();
  }

  // Close team filter menu when clicking outside
  document.addEventListener("click", function(e) {
    var dropdown = document.getElementById("team-filter-dropdown");
    if (dropdown && !dropdown.contains(e.target)) {
      document.getElementById("team-filter-menu").style.display = "none";
    }
  });

  loadTeamFilter();

  // ── Current time line ────────────────────────────────────────────────────
  function updateCurrentTimeLine() {
    var grid = document.querySelector(".grid-wrapper");
    if (!grid) return;

    var scheduleDate = grid.dataset.scheduleDate;
    var today = new Date().toLocaleDateString("en-CA"); // YYYY-MM-DD in local time
    if (scheduleDate !== today) return;

    var now = new Date();
    var nowMinutes = now.getHours() * 60 + now.getMinutes() + now.getSeconds() / 60;

    var rows = document.querySelectorAll(".schedule-grid tbody tr[data-hour]");
    var gridRect = grid.getBoundingClientRect();
    var prevRow = null, nextRow = null, prevMin = -1, nextMin = -1;

    rows.forEach(function(row) {
      var rowMin = parseInt(row.dataset.hour) * 60 + parseInt(row.dataset.min);
      if (rowMin <= nowMinutes) { prevRow = row; prevMin = rowMin; }
      else if (!nextRow) { nextRow = row; nextMin = rowMin; }
    });

    var line = document.getElementById("current-time-line");
    if (!line) {
      line = document.createElement("div");
      line.id = "current-time-line";
      grid.appendChild(line);
    }

    if (!prevRow) { line.style.display = "none"; return; }

    var top;
    var prevRect = prevRow.getBoundingClientRect();
    if (nextRow) {
      var nextRect = nextRow.getBoundingClientRect();
      var fraction = (nowMinutes - prevMin) / (nextMin - prevMin);
      top = prevRect.top + fraction * (nextRect.top - prevRect.top) - gridRect.top;
    } else {
      top = prevRect.bottom - gridRect.top;
    }

    line.style.top = Math.round(top) + "px";
    line.style.display = "block";
  }

  updateCurrentTimeLine();
  setInterval(updateCurrentTimeLine, 60000);
</script>
