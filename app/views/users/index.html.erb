<h1>Users (<%= @users.count %>)</h1>

<div class="teams-toolbar">
  <div class="teams-toolbar-left">
    <%= link_to "New User", new_user_path, class: "btn btn-primary" %>
  </div>
</div>

<div class="table-scroll">
<table class="teams-table">
  <thead>
    <tr>
      <th>Username</th>
      <th>Created</th>
      <th>Last Seen</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td>
          <%= user.username %>
          <% if user == current_user %>
            <span class="current-user-badge">you</span>
          <% end %>
        </td>
        <td><%= user.created_at.strftime("%b %-d, %Y") %></td>
        <td>
          <% if user.last_seen_at %>
            <span class="local-time" data-utc="<%= user.last_seen_at.iso8601 %>"></span>
          <% else %>
            —
          <% end %>
        </td>
        <td class="actions-cell">
          <% if user != current_user %>
            <%= button_to "Delete", user_path(user), method: :delete, class: "btn btn-small btn-danger",
                data: { turbo_confirm: "Delete user \"#{user.username}\"?" } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>

<script>
  document.querySelectorAll(".local-time").forEach(function(el) {
    var d = new Date(el.dataset.utc);
    el.textContent = d.toLocaleString(undefined, {
      month: "short", day: "numeric", year: "numeric",
      hour: "numeric", minute: "2-digit"
    });
  });
</script>
