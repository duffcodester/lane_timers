<h1>Sessions (<%= @meet_sessions.length %>)</h1>

<%= link_to "New Session", new_meet_session_path, class: "btn btn-primary" %>

<table class="teams-table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Date</th>
      <th>Start Time</th>
      <th>End Time</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @meet_sessions.each do |session| %>
      <tr>
        <td><%= session.name %></td>
        <td><%= session.date.strftime("%A, %B %d, %Y") %></td>
        <td><%= session.start_time.strftime("%l:%M %p").strip %></td>
        <td><%= session.end_time.strftime("%l:%M %p").strip %></td>
        <td class="actions-cell">
          <%= link_to "Edit", edit_meet_session_path(session), class: "btn btn-small" %>
          <%= button_to "Delete", meet_session_path(session), method: :delete, class: "btn btn-small btn-danger",
              data: { turbo_confirm: "Delete session for #{session.date.strftime('%B %d, %Y')}?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
