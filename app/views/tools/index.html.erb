<% content_for :title, "Tools – Sage Timer" %>

<h1>Tools</h1>

<div class="tools-page">

  <section class="tools-section">
    <h2>Info</h2>
    <div class="tools-content">
      <p>Welcome to the Sage Timer tools page. Add information, links, FAQs, and downloadable files here.</p>
    </div>
  </section>

  <section class="tools-section">
    <h2>Links</h2>
    <ul class="tools-list">
      <li><a href="https://www.youtube.com/watch?v=ZVFce0ZtaSk" target="_blank">Become a Timer! Its EASY! (How to Time at a Swim Meet, Sarasota Sharks)</a></li>
      <li><a href="https://www.youtube.com/watch?v=7wzGzJTvivM" target="_blank">Swim Meet Timer Tutorial | Swim Club at IU (Bill Ramos, Head Coach SCIU)</a></li>
      <li><a href="https://www.youtube.com/watch?v=f8Lie7L_m2A" target="_blank">How to be a timer at a swim meet? (Heritage Landing Hammerheads, Coach Susan and Frank)</a></li>
    </ul>
  </section>

  <section class="tools-section">
    <h2>FAQs</h2>
    <div class="tools-faqs">
      <%# Add FAQ items here %>
      <p><em>No FAQs added yet.</em></p>
    </div>
  </section>

  <section class="tools-section">
    <h2>Files</h2>
    <% if @files.any? %>
      <ul class="tools-list tools-files">
        <% @files.each do |filename| %>
          <li>
            <%= link_to filename, "/tools/#{filename}" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p><em>No files available. Place files in <code>public/tools/</code> to make them available here.</em></p>
    <% end %>
  </section>

</div>
