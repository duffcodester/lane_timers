<h1>Teams (<%= @teams.length %>)</h1>

<%= link_to "New Team", new_team_path, class: "btn btn-primary" %>
<%= link_to "Export to Excel", export_teams_path, class: "btn" %>

<table class="teams-table">
  <thead>
    <tr>
      <th>Color</th>
      <th>Name</th>
      <th>Abbr</th>
      <th>Coach Name(s)</th>
      <th>Address</th>
      <th>Phone</th>
      <th>Email</th>
      <th>Hours</th>
      <th>Misc Expense</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @teams.each do |team| %>
      <tr>
        <td><span class="color-swatch" style="background-color: <%= team.color %>"></span></td>
        <td><%= team.name %></td>
        <td><%= team.abbreviation %></td>
        <td><%= team.coach %></td>
        <td><%= team.address %></td>
        <td><%= team.phone %></td>
        <td><%= team.email %></td>
        <td><%= "%.2f" % team.total_hours.to_f %></td>
        <td><%= number_to_currency(team.misc_expense) %></td>
        <td class="actions-cell">
          <%= link_to "Edit", edit_team_path(team), class: "btn btn-small" %>
          <%= button_to "Delete", team_path(team), method: :delete, class: "btn btn-small btn-danger",
              data: { turbo_confirm: "Delete #{team.name}?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
