<h1>Teams (<%= @total_count %>)</h1>

<% all_columns = %w[name abbreviation coach hours booked address phone email misc_expense actions] %>

<div class="teams-toolbar">
  <div class="teams-toolbar-left">
    <%= link_to "New Team", new_team_path, class: "btn btn-primary" %>
    <%= link_to "Export to Excel", export_teams_path, class: "btn" %>
    <%= form_tag import_teams_path, multipart: true, class: "import-form" do %>
      <%= file_field_tag :file, accept: ".csv", onchange: "this.form.submit()" %>
      <label for="file" class="btn">Import CSV</label>
    <% end %>
    <div class="columns-dropdown">
      <button type="button" class="btn" onclick="toggleColumnsMenu()">Columns</button>
      <div id="columns-menu" class="columns-menu" style="display:none">
        <% { "name" => "Name", "abbreviation" => "Abbr", "coach" => "Coach", "hours" => "Forecast", "booked" => "Booked",
             "address" => "Address", "phone" => "Phone", "email" => "Email",
             "misc_expense" => "Misc Expense", "actions" => "Actions" }.each do |col, label| %>
          <% visible = @column_prefs.empty? || @column_prefs[col] != false %>
          <label><input type="checkbox" data-col="<%= col %>" <%= "checked" if visible %> onchange="toggleColumn('<%= col %>')"> <%= label %></label>
        <% end %>
      </div>
    </div>
  </div>
  <%= form_tag teams_path, method: :get, class: "search-form" do %>
    <%= text_field_tag :search, params[:search], placeholder: "Search teams...", class: "search-input" %>
    <%= submit_tag "Search", class: "btn btn-small" %>
    <% if params[:search].present? %>
      <%= link_to "Clear", teams_path, class: "btn btn-small" %>
    <% end %>
  <% end %>
</div>

<table class="teams-table">
  <thead>
    <tr>
      <% hidden = @column_prefs.select { |_, v| v == false }.keys %>
      <th data-col="name" <%= 'style="display:none"'.html_safe if hidden.include?("name") %>><%= sort_link "Name", "name" %></th>
      <th data-col="abbreviation" <%= 'style="display:none"'.html_safe if hidden.include?("abbreviation") %>><%= sort_link "Abbr", "abbreviation" %></th>
      <th data-col="coach" <%= 'style="display:none"'.html_safe if hidden.include?("coach") %>><%= sort_link "Coach Name(s)", "coach" %></th>
      <th data-col="hours" <%= 'style="display:none"'.html_safe if hidden.include?("hours") %>><%= sort_link "Forecast", "hours" %></th>
      <th data-col="booked" <%= 'style="display:none"'.html_safe if hidden.include?("booked") %>><%= sort_link "Booked", "booked" %></th>
      <th data-col="address" <%= 'style="display:none"'.html_safe if hidden.include?("address") %>><%= sort_link "Address", "address" %></th>
      <th data-col="phone" <%= 'style="display:none"'.html_safe if hidden.include?("phone") %>><%= sort_link "Phone", "phone" %></th>
      <th data-col="email" <%= 'style="display:none"'.html_safe if hidden.include?("email") %>><%= sort_link "Email", "email" %></th>
      <th data-col="misc_expense" <%= 'style="display:none"'.html_safe if hidden.include?("misc_expense") %>><%= sort_link "Misc Expense", "misc_expense" %></th>
      <th data-col="actions" <%= 'style="display:none"'.html_safe if hidden.include?("actions") %>>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @teams.each do |team| %>
      <tr>
        <td data-col="name" <%= 'style="display:none"'.html_safe if hidden.include?("name") %>>
          <span class="color-swatch" style="background-color: <%= team.color %>; display:inline-block; vertical-align:middle"></span>
          <%= team.name %>
        </td>
        <td data-col="abbreviation" <%= 'style="display:none"'.html_safe if hidden.include?("abbreviation") %>><%= team.abbreviation %></td>
        <td data-col="coach" <%= 'style="display:none"'.html_safe if hidden.include?("coach") %>><%= team.coach %></td>
        <td data-col="hours" <%= 'style="display:none"'.html_safe if hidden.include?("hours") %>><%= "%.2f" % team.total_hours.to_f %></td>
        <td data-col="booked" <%= 'style="display:none"'.html_safe if hidden.include?("booked") %>><%= "%.2f" % team.booked_hours.to_f %></td>
        <td data-col="address" <%= 'style="display:none"'.html_safe if hidden.include?("address") %>><%= team.address %></td>
        <td data-col="phone" <%= 'style="display:none"'.html_safe if hidden.include?("phone") %>><%= team.phone %></td>
        <td data-col="email" <%= 'style="display:none"'.html_safe if hidden.include?("email") %>><%= team.email %></td>
        <td data-col="misc_expense" <%= 'style="display:none"'.html_safe if hidden.include?("misc_expense") %>><%= number_to_currency(team.misc_expense) %></td>
        <td data-col="actions" class="actions-cell" <%= 'style="display:none"'.html_safe if hidden.include?("actions") %>>
          <%= link_to "Edit", edit_team_path(team), class: "btn btn-small" %>
          <%= button_to "Delete", team_path(team), method: :delete, class: "btn btn-small btn-danger",
              data: { turbo_confirm: "Delete #{team.name}?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<script>
  function toggleColumnsMenu() {
    var menu = document.getElementById("columns-menu");
    menu.style.display = menu.style.display === "none" ? "block" : "none";
  }

  function toggleColumn(col) {
    var cells = document.querySelectorAll(".teams-table [data-col='" + col + "']");
    var checkbox = document.querySelector("input[data-col='" + col + "']");
    var display = checkbox.checked ? "" : "none";
    cells.forEach(function(cell) { cell.style.display = display; });
    saveColumnPrefs();
  }

  function saveColumnPrefs() {
    var prefs = {};
    document.querySelectorAll("#columns-menu input[type='checkbox']").forEach(function(cb) {
      prefs[cb.dataset.col] = cb.checked;
    });
    var token = document.querySelector("meta[name='csrf-token']").content;
    fetch("<%= teams_columns_setting_path %>", {
      method: "PATCH",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": token
      },
      body: JSON.stringify({ columns: prefs })
    });
  }

  // Close menu when clicking outside
  document.addEventListener("click", function(e) {
    var dropdown = document.querySelector(".columns-dropdown");
    if (dropdown && !dropdown.contains(e.target)) {
      document.getElementById("columns-menu").style.display = "none";
    }
  });
</script>

<%= render "shared/pagination", current_page: @current_page, total_pages: @total_pages %>
