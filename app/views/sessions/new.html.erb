<% content_for :title, "Login – Sage Timer" %>

<div class="login-container">
  <h1 class="login-title">Sage Timer</h1>

  <%= form_with url: login_path, class: "login-form" do |f| %>
    <% if alert %>
      <div class="flash flash-alert"><%= alert %></div>
    <% end %>

    <div class="form-group">
      <%= f.label :username, "Username" %>
      <%= f.text_field :username, autocomplete: "username", autofocus: true, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "Password" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
    </div>

    <%= f.submit "Log In", class: "btn btn-primary btn-full" %>
  <% end %>
</div>
